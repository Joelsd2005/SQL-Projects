-- Select all records from the dataset
SELECT * FROM worldlifeexpectancy;

-- Identify duplicate records based on Country and Year
SELECT Country, Year, CONCAT(Country, Year), COUNT(CONCAT(Country, Year))
FROM worldlifeexpectancy
GROUP BY Country, Year, CONCAT(Country, Year)
HAVING COUNT(CONCAT(Country, Year)) > 1;

-- Identify duplicate rows by assigning a row number to each duplicate entry
SELECT *
FROM (
      SELECT Row_ID,
             CONCAT(Country, Year),
             ROW_NUMBER() OVER( PARTITION BY CONCAT(Country, Year) ORDER BY CONCAT(Country, Year)) AS Row_Num
      FROM worldlifeexpectancy
     ) AS Row_table
WHERE Row_Num > 1;

-- Delete duplicate records while keeping only one occurrence
DELETE FROM worldlifeexpectancy
WHERE Row_ID IN (
      SELECT Row_ID
      FROM (
            SELECT Row_ID,
                   CONCAT(Country, Year),
                   ROW_NUMBER() OVER( PARTITION BY CONCAT(Country, Year) ORDER BY CONCAT(Country, Year)) AS Row_Num
            FROM worldlifeexpectancy
           ) AS Row_table
      WHERE Row_Num > 1
);

-- Select records where the Status column is empty
SELECT *
FROM worldlifeexpectancy
WHERE Status = '';

-- Get distinct values of Status excluding empty values
SELECT DISTINCT(Status)
FROM worldlifeexpectancy
WHERE Status <> '';

-- Get distinct country names where Status is 'Developing'
SELECT DISTINCT(Country)
FROM worldlifeexpectancy
WHERE Status = 'Developing';

-- Ensure all countries classified as 'Developing' retain that status
UPDATE worldlifeexpectancy
SET Status = 'Developing'
WHERE Country IN (
    SELECT DISTINCT(Country)
    FROM worldlifeexpectancy
    WHERE Status = 'Developing'
);

-- Assign 'Developing' status to countries where it is missing but exists elsewhere for the same country
UPDATE worldlifeexpectancy t1                
JOIN worldlifeexpectancy t2
    ON t1.Country = t2.Country
SET t1.Status = 'Developing'
WHERE t1.Status = ''
AND t2.Status <> ''
AND t2.Status = 'Developing';

-- Select all records for the United States Of America
SELECT *
FROM worldlifeexpectancy
WHERE Country = 'United States Of America';

-- Assign 'Developed' status to countries where it is missing but exists elsewhere for the same country
UPDATE worldlifeexpectancy t1                
JOIN worldlifeexpectancy t2
    ON t1.Country = t2.Country
SET t1.Status = 'Developed'
WHERE t1.Status = ''
AND t2.Status <> ''
AND t2.Status = 'Developed';

-- Select records where Life Expectancy is missing
SELECT *
FROM worldlifeexpectancy
WHERE `Life expectancy` = '';

-- Identify countries and years where Life Expectancy is missing
SELECT Country, Year, `Life expectancy`
FROM worldlifeexpectancy
WHERE `Life expectancy` = '';

-- Calculate the missing Life Expectancy by taking the average of previous and next year's values
SELECT t1.Country, t1.Year, t1.`Life expectancy`, 
       t2.Country, t2.Year, t2.`Life expectancy`,
       t3.Country, t3.Year, t3.`Life expectancy`,
       ROUND((t2.`Life expectancy` + t3.`Life expectancy`)/2,1) AS Estimated_Life_Expectancy
FROM worldlifeexpectancy t1
JOIN worldlifeexpectancy t2
    ON t1.Country = t2.Country
    AND t1.Year = t2.Year - 1
JOIN worldlifeexpectancy t3
    ON t1.Country = t3.Country
    AND t1.Year = t3.Year + 1
WHERE t1.`Life expectancy` = '';

-- Update the missing Life Expectancy values with the calculated average from adjacent years
UPDATE worldlifeexpectancy t1
JOIN worldlifeexpectancy t2
    ON t1.Country = t2.Country
    AND t1.Year = t2.Year - 1
JOIN worldlifeexpectancy t3
    ON t1.Country = t3.Country
    AND t1.Year = t3.Year + 1
SET t1.`Life expectancy` = ROUND((t2.`Life expectancy` + t3.`Life expectancy`)/2,1)
WHERE t1.`Life expectancy` = '';

-- Select all records after cleaning
SELECT *
FROM worldlifeexpectancy;
